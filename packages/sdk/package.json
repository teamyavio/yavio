{
  "name": "@yavio/sdk",
  "version": "0.5.5",
  "description": "Yavio SDK for instrumenting MCP servers with analytics, session tracking, and a React widget",
  "type": "module",
  "license": "MIT",
  "author": "Yavio GmbH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teamyavio/yavio.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://yavio.ai",
  "bugs": "https://github.com/teamyavio/yavio/issues",
  "keywords": [
    "yavio",
    "mcp",
    "model-context-protocol",
    "analytics",
    "instrumentation",
    "observability",
    "ai",
    "llm"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "files": ["dist", "react/package.json", "LICENSE", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "nanoid": "^5.1.16"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.24.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.14",
    "@yavio/shared": "workspace:*",
    "jsdom": "^28.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "zod": "^4.3.6"
  }
}
